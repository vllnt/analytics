{
  "name": "@vllnt/analytics",
  "version": "0.2.0",
  "description": "Cookie consent state and consent-gated event tracking for React and TypeScript, with Do Not Track and an SSR consent cookie.",
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "license": "MIT",
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vllnt/analytics.git"
  },
  "homepage": "https://oss.vllnt.com/packages/analytics",
  "bugs": {
    "url": "https://github.com/vllnt/analytics/issues"
  },
  "keywords": [
    "analytics",
    "event-tracking",
    "cookie-consent",
    "consent-management",
    "gdpr",
    "do-not-track",
    "privacy",
    "react",
    "react-hooks",
    "ssr",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "docs/API.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf node_modules dist",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ . --fix",
    "test": "vitest",
    "test:once": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "bash scripts/test-package.sh",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/eslint-config": "^2.1.0",
    "@vllnt/typescript": "^3.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
