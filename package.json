{
  "name": "@vllnt/analytics",
  "version": "0.2.0",
  "description": "Lightweight, privacy-first analytics with consent management and React integration",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vllnt/analytics.git"
  },
  "keywords": [
    "analytics",
    "consent",
    "privacy",
    "gdpr",
    "react",
    "do-not-track"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf node_modules dist",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ . --fix",
    "test": "vitest",
    "test:once": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vllnt/eslint-config": "^2.0.0",
    "@vllnt/typescript": "^2.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "overrides": {
      "deepmerge-ts@<8.0.0": "8.0.0",
      "handlebars@<4.7.10": "4.7.10"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
